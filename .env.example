# Names only. Never add real values, tokens, or credentials to this file.

# Standalone Sanity Studio configuration. Put approved values only in apps/studio/.env.local.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Static Astro build-time configuration. Keep these unprefixed and validate them before use.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=

# Reserved server/build-only draft access. It is currently unused and must never use PUBLIC_.
SANITY_API_READ_TOKEN=

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { HomeLocale, HomePageData } from "../../types/home";
import type { ValidatedCredential } from "../../lib/sanity/types";
import { getCredentialsArchivePath } from "../../lib/routes";
import SiteHeader from "../navigation/SiteHeader.astro";
import SiteFooter from "../layout/SiteFooter.astro";
import CredentialsPreview from "../sections/CredentialsPreview.astro";

interface Props {
  locale: HomeLocale;
  homeData: HomePageData;
  credentials: readonly ValidatedCredential[];
}

const { locale, homeData, credentials } = Astro.props;
const pathname = getCredentialsArchivePath(locale);
const copy =
  locale === "id"
    ? {
        eyebrow: "Kredensial",
        title: "Pendidikan dan kredensial",
        description:
          "Pendidikan, sertifikasi, penghargaan, dan status publikasi dalam satu katalog ringkas.",
        libraryTitle: "Katalog kredensial",
        statusLabel: "Status",
      }
    : {
        eyebrow: "Credentials",
        title: "Education and credentials",
        description:
          "Education, certifications, honors, and publication status in one concise catalog.",
        libraryTitle: "Credential catalog",
        statusLabel: "Status",
      };
const data: HomePageData["credentials"] = {
  id: "credentials",
  heading: copy.libraryTitle,
  description: copy.description,
  statusLabel: copy.statusLabel,
  items: credentials.map((item) => ({
    id: item.id,
    category: item.category[locale],
    statusValue:
      item.visibility === "unavailable"
        ? locale === "id"
          ? "Belum tersedia"
          : "Unavailable"
        : (item.issuer ?? item.summary[locale]),
    credential: item.presentation[locale],
  })),
};
---

<BaseLayout
  metadata={{
    locale,
    title: `${copy.title} — Portfolio Owner`,
    description: copy.description,
    pathname,
    indexable: true,
  }}
>
  <div class="site-shell site-shell--content-system">
    <SiteHeader
      data={homeData}
      currentDestination="credentials"
      currentPathname={pathname}
    />
    <main id="main-content" class="content-page-main">
      <header class="content-page-hero">
        <p>{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p>{copy.description}</p>
      </header>
      <CredentialsPreview data={data} lang={locale} showGalleries />
    </main>
    <SiteFooter data={homeData.footer} />
  </div>
</BaseLayout>

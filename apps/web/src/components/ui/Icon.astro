---
export type IconName =
  | "home"
  | "profile"
  | "journey"
  | "capabilities"
  | "projects"
  | "education"
  | "credentials"
  | "honors"
  | "publications"
  | "contact"
  | "external"
  | "document"
  | "linkedin"
  | "github"
  | "email";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={[
    className,
    {
      "icon--brand": name === "linkedin" || name === "github",
      "icon--solid": name === "email",
    },
  ]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "home" && (
      <path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z" />
    )
  }
  {
    name === "profile" && (
      <>
        <circle cx="12" cy="8" r="3" />
        <path d="M6.5 20v-1.5a5.5 5.5 0 0 1 11 0V20" />
      </>
    )
  }
  {
    name === "journey" && (
      <>
        <circle cx="6" cy="18" r="2" />
        <circle cx="18" cy="6" r="2" />
        <path d="M7.5 16.5 16.5 7.5M9 6H5a1 1 0 0 0-1 1v4" />
      </>
    )
  }
  {
    name === "capabilities" && (
      <>
        <path d="m12 3 8 4.5-8 4.5-8-4.5z" />
        <path d="m4 12 8 4.5 8-4.5M4 16.5 12 21l8-4.5" />
      </>
    )
  }
  {
    name === "projects" && (
      <>
        <rect x="3" y="6" width="18" height="14" rx="2" />
        <path d="M8 6V4h8v2M3 11h18" />
      </>
    )
  }
  {
    name === "education" && (
      <>
        <path d="m3 9 9-5 9 5-9 5z" />
        <path d="M7 12.5V17c2.8 2 7.2 2 10 0v-4.5M21 9v6" />
      </>
    )
  }
  {
    name === "credentials" && (
      <>
        <path d="M6 3h12v13H6zM9 7h6M9 10h6" />
        <path d="m9 16-1 5 4-2 4 2-1-5" />
      </>
    )
  }
  {
    name === "contact" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "honors" && (
      <>
        <path d="M8 4h8v5a4 4 0 0 1-8 0zM10 13v3M14 13v3M8 20h8M10 16h4" />
        <path d="M8 6H5v2a3 3 0 0 0 3 3M16 6h3v2a3 3 0 0 1-3 3" />
      </>
    )
  }
  {
    name === "publications" && (
      <>
        <path d="M5 4h10a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2z" />
        <path d="M17 7h2v13h-2M8 8h6M8 12h6M8 16h4" />
      </>
    )
  }
  {
    name === "external" && (
      <>
        <path d="M14 5h5v5M19 5l-8 8" />
        <path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
      </>
    )
  }
  {
    name === "document" && (
      <>
        <path d="M6 2h8l4 4v16H6z" />
        <path d="M14 2v5h5M9 12h6M9 16h6" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <path d="M20.45 3H3.55A.55.55 0 0 0 3 3.55v16.9c0 .3.25.55.55.55h16.9c.3 0 .55-.25.55-.55V3.55a.55.55 0 0 0-.55-.55ZM8.34 18.34H5.67V9.75h2.67v8.59ZM7 8.58a1.55 1.55 0 1 1 0-3.1 1.55 1.55 0 0 1 0 3.1Zm11.34 9.76h-2.66v-4.18c0-1-.02-2.28-1.39-2.28-1.39 0-1.6 1.09-1.6 2.2v4.26h-2.67V9.75h2.56v1.17h.04c.36-.68 1.23-1.39 2.53-1.39 2.7 0 3.2 1.78 3.2 4.1v4.71Z" />
    )
  }
  {
    name === "github" && (
      <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.83c.85 0 1.69.11 2.48.33 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
    )
  }
  {
    name === "email" && (
      <path d="M3.75 5h16.5c.69 0 1.25.56 1.25 1.25v11.5c0 .69-.56 1.25-1.25 1.25H3.75c-.69 0-1.25-.56-1.25-1.25V6.25C2.5 5.56 3.06 5 3.75 5Zm.13 2 7.33 5.36a1.33 1.33 0 0 0 1.58 0L20.12 7H3.88Z" />
    )
  }
</svg>

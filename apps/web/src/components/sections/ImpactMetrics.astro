---
import type { HomePageData } from "../../types/home";

interface Props {
  data: HomePageData["impact"];
}

const { data } = Astro.props;
const headingId = `${data.id}-heading`;
---

<section class="impact-section" id={data.id} aria-labelledby={headingId}>
  <div class="impact-section__header">
    <h2 class="impact-section__heading" id={headingId}>{data.heading}</h2>
    <p class="impact-section__description">{data.description}</p>
  </div>

  <ul class="impact-section__list">
    {
      data.items.map((item) => (
        <li class="impact-section__item">
          <h3 class="impact-section__item-heading">{item.category}</h3>
          <dl class="impact-section__status">
            <div>
              <dt>{data.statusLabel}</dt>
              <dd>{item.status}</dd>
            </div>
          </dl>
          <p class="impact-section__context">{item.context}</p>
        </li>
      ))
    }
  </ul>
</section>

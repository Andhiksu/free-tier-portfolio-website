---
import type { HomeLocale } from "../../types/home";
import type { ValidatedCredential } from "../../lib/sanity/types";
import CredentialIssuerMark from "../media/CredentialIssuerMark.astro";
import CredentialPreviewCard from "../media/CredentialPreviewCard.astro";
import Icon, { type IconName } from "../ui/Icon.astro";

type CredentialCategory =
  "education" | "certifications" | "honors" | "publications";

interface Props {
  records: readonly ValidatedCredential[];
  locale: HomeLocale;
}

const { records, locale } = Astro.props;
const copy = {
  en: {
    eyebrow: "Professional record",
    title: "Credentials",
    education: {
      title: "Education",
    },
    certifications: {
      title: "Licenses & Certifications",
    },
    honors: {
      title: "Honors & Awards",
    },
    publications: {
      title: "Publications",
    },
    empty: "No approved public record is available in this category yet.",
    unavailable: "Publication record is not publicly available yet.",
    open: "Open record",
    recordCount: "public records",
    backLabel: "Back to Credentials",
  },
  id: {
    eyebrow: "Rekam profesional",
    title: "Kredensial",
    education: {
      title: "Pendidikan",
    },
    certifications: {
      title: "Lisensi & Sertifikasi",
    },
    honors: {
      title: "Penghargaan",
    },
    publications: {
      title: "Publikasi",
    },
    empty: "Belum ada catatan publik yang disetujui untuk kategori ini.",
    unavailable: "Catatan publikasi belum tersedia untuk publik.",
    open: "Buka catatan",
    recordCount: "catatan publik",
    backLabel: "Kembali ke Kredensial",
  },
} as const;
const localizedCopy = copy[locale];
const categoryByEnglishLabel: Readonly<Record<CredentialCategory, string>> = {
  education: "Education",
  certifications: "Licenses & Certifications",
  honors: "Achievements",
  publications: "Publications",
};
const iconByCategory: Readonly<Record<CredentialCategory, IconName>> = {
  education: "education",
  certifications: "credentials",
  honors: "honors",
  publications: "publications",
};
const categories = (
  ["education", "certifications", "honors", "publications"] as const
).map((id) => ({
  id,
  icon: iconByCategory[id],
  title: localizedCopy[id].title,
  records: records
    .filter(
      (record) =>
        record.category.en === categoryByEnglishLabel[id] &&
        (id !== "publications" || record.visibility === "public"),
    )
    .toSorted(
      (left, right) =>
        (right.issueDate ?? "").localeCompare(left.issueDate ?? "") ||
        left.order - right.order,
    ),
}));
const dateFormatter = new Intl.DateTimeFormat(
  locale === "id" ? "id-ID" : "en-US",
  { month: "short", year: "numeric", timeZone: "UTC" },
);
const formatDate = (value: string) =>
  dateFormatter.format(new Date(`${value}T00:00:00Z`));
---

<section
  class="credential-workspace credentials-hub home-section"
  id="credentials"
  aria-labelledby="credentials-heading"
  data-credentials-hub
>
  <header class="credentials-hub__header">
    <p class="credentials-hub__eyebrow">{localizedCopy.eyebrow}</p>
    <h2 id="credentials-heading">{localizedCopy.title}</h2>
  </header>

  <nav
    class="credentials-hub__nav"
    aria-label={localizedCopy.title}
    data-credential-navigation
  >
    {
      categories.map((category, index) => (
        <a
          class="credentials-hub__tab"
          href={`#${category.id}`}
          data-credential-tab={category.id}
          data-credential-category={category.id}
        >
          <span class="credentials-hub__tab-index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="credentials-hub__tab-icon" aria-hidden="true">
            <Icon name={category.icon} />
          </span>
          <span class="credentials-hub__tab-copy">
            <strong>{category.title}</strong>
          </span>
          <span
            class="credentials-hub__count"
            aria-label={`${category.records.length} ${localizedCopy.recordCount}`}
          >
            {String(category.records.length).padStart(2, "0")}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="credentials-hub__content">
    {
      categories.map((category, index) => (
        <section
          class="credentials-hub__panel"
          id={category.id}
          aria-labelledby={`${category.id}-heading`}
          data-credential-panel={category.id}
          data-credential-active={index === 0 ? "true" : "false"}
        >
          <div class="credentials-hub__panel-heading">
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3 id={`${category.id}-heading`}>{category.title}</h3>
            </div>
          </div>

          {category.records.length > 0 ? (
            <div
              class="credentials-hub__panel-body"
              data-credential-panel-body={category.id}
            >
              <ul
                class="credential-workspace__grid"
                role="list"
                data-credential-grid={category.id}
              >
                {category.records.map((record) => (
                  <li>
                    <a
                      class:list={[
                        "credential-workspace__card",
                        {
                          "credential-workspace__card--unavailable":
                            record.visibility === "unavailable",
                        },
                      ]}
                      href={`#${record.id}`}
                      data-credential-card-trigger={record.id}
                    >
                      <CredentialIssuerMark
                        issuer={record.issuer ?? record.name[locale]}
                        title={record.name[locale]}
                        category={record.category[locale]}
                        logo={record.presentation[locale].issuerLogo}
                        locale={locale}
                        compact
                      />
                      <div class="credential-workspace__card-copy">
                        <h4>{record.name[locale]}</h4>
                        {record.issuer && <p>{record.issuer}</p>}
                        {record.issueDate && (
                          <time datetime={record.issueDate}>
                            {formatDate(record.issueDate)}
                          </time>
                        )}
                        {record.visibility === "unavailable" && (
                          <p>{localizedCopy.unavailable}</p>
                        )}
                        <span class="credential-workspace__action">
                          {localizedCopy.open}
                          <span aria-hidden="true">↗</span>
                        </span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>

              <div
                class="credential-workspace__details"
                data-credential-details-container={category.id}
              >
                {category.records.map((record) => (
                  <div
                    class="credential-record-detail record-detail"
                    id={record.id}
                    data-credential-detail={record.id}
                    data-category-id={category.id}
                    hidden
                  >
                    <button
                      type="button"
                      class="record-detail__back"
                      data-credential-back={category.id}
                    >
                      <span aria-hidden="true">←</span>
                      {localizedCopy.backLabel}
                    </button>
                    <CredentialPreviewCard
                      credential={record.presentation[locale]}
                      locale={locale}
                      headingLevel={4}
                      showGallery={true}
                      category={record.category[locale]}
                    />
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p class="credential-workspace__empty">{localizedCopy.empty}</p>
          )}
        </section>
      ))
    }
  </div>
</section>

<script>
  const credentialCategoryIds = [
    "education",
    "certifications",
    "honors",
    "publications",
  ] as const;

  document
    .querySelectorAll<HTMLElement>("[data-credentials-hub]")
    .forEach((hub) => {
      const tabs = Array.from(
        hub.querySelectorAll<HTMLAnchorElement>("[data-credential-tab]"),
      );
      const panels = Array.from(
        hub.querySelectorAll<HTMLElement>("[data-credential-panel]"),
      );

      const getHash = () => {
        try {
          return decodeURIComponent(window.location.hash.replace(/^#/, ""));
        } catch {
          return "";
        }
      };

      const readCategoryAndRecord = () => {
        const hash = getHash();
        if (!hash) return { category: "education", recordId: "" };

        if (
          credentialCategoryIds.includes(
            hash as (typeof credentialCategoryIds)[number],
          )
        ) {
          return { category: hash, recordId: "" };
        }

        const detailEl = hub.querySelector<HTMLElement>(
          `[data-credential-detail="${hash}"]`,
        );
        if (detailEl && detailEl.dataset.categoryId) {
          return { category: detailEl.dataset.categoryId, recordId: hash };
        }

        return { category: "education", recordId: "" };
      };

      const syncLocaleLinks = (hashTarget: string) => {
        document
          .querySelectorAll<HTMLAnchorElement>("[data-locale-link]")
          .forEach((link) => {
            const targetUrl = new URL(link.href, window.location.href);
            targetUrl.hash = `#${hashTarget}`;
            link.href = targetUrl.href;
          });
      };

      const activateCategoryAndRecord = (
        category: string,
        recordId: string,
        focus: boolean,
      ) => {
        tabs.forEach((tab) => {
          if (tab.dataset.credentialTab === category) {
            tab.setAttribute("aria-current", "location");
          } else {
            tab.removeAttribute("aria-current");
          }
        });

        panels.forEach((panel) => {
          const active = panel.dataset.credentialPanel === category;
          panel.dataset.credentialActive = String(active);
          panel.hidden = !active;

          if (active) {
            const grid = panel.querySelector<HTMLElement>(
              "[data-credential-grid]",
            );
            const details = Array.from(
              panel.querySelectorAll<HTMLElement>("[data-credential-detail]"),
            );

            if (recordId) {
              if (grid) grid.hidden = true;
              details.forEach((detail) => {
                const isTarget = detail.dataset.credentialDetail === recordId;
                detail.hidden = !isTarget;
              });
            } else {
              if (grid) grid.hidden = false;
              details.forEach((detail) => {
                detail.hidden = true;
              });
            }
          }
        });

        if (focus) {
          const targetEl = recordId
            ? hub.querySelector<HTMLElement>(
                `[data-credential-detail="${recordId}"]`,
              )
            : hub.querySelector<HTMLElement>(
                `[data-credential-panel="${category}"] h3`,
              );

          targetEl?.setAttribute("tabindex", "-1");
          targetEl?.focus({ preventScroll: true });
          targetEl?.addEventListener(
            "blur",
            () => targetEl.removeAttribute("tabindex"),
            { once: true },
          );
        }

        syncLocaleLinks(recordId || category);
      };

      hub.dataset.credentialsReady = "true";
      const initial = readCategoryAndRecord();
      activateCategoryAndRecord(initial.category, initial.recordId, false);

      tabs.forEach((tab) => {
        tab.addEventListener("click", (event) => {
          const category = tab.dataset.credentialTab;
          if (!category) return;

          event.preventDefault();
          const nextUrl = new URL(window.location.href);
          nextUrl.hash = `#${category}`;
          window.history.pushState(null, "", nextUrl);
          activateCategoryAndRecord(category, "", true);
        });
      });

      hub.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        const trigger = event.target.closest<HTMLAnchorElement>(
          "[data-credential-card-trigger]",
        );
        if (trigger) {
          const targetHash = trigger.getAttribute("href")?.replace(/^#/, "");
          if (targetHash) {
            const detailEl = hub.querySelector<HTMLElement>(
              `[data-credential-detail="${targetHash}"]`,
            );
            if (detailEl && detailEl.dataset.categoryId) {
              event.preventDefault();
              const category = detailEl.dataset.categoryId;
              const nextUrl = new URL(window.location.href);
              nextUrl.hash = `#${targetHash}`;
              window.history.pushState(null, "", nextUrl);
              activateCategoryAndRecord(category, targetHash, true);
              return;
            }
          }
        }

        const backBtn = event.target.closest<HTMLButtonElement>(
          "[data-credential-back]",
        );
        if (backBtn) {
          event.preventDefault();
          const category = backBtn.dataset.credentialBack || "education";
          const nextUrl = new URL(window.location.href);
          nextUrl.hash = `#${category}`;
          window.history.pushState(null, "", nextUrl);
          activateCategoryAndRecord(category, "", true);
        }
      });

      window.addEventListener("popstate", () => {
        const current = readCategoryAndRecord();
        activateCategoryAndRecord(current.category, current.recordId, true);
      });

      window.addEventListener("hashchange", () => {
        const current = readCategoryAndRecord();
        activateCategoryAndRecord(current.category, current.recordId, true);
      });
    });
</script>

---
import type { HomePageData } from "../../types/home";
import CredentialPreviewCard from "../media/CredentialPreviewCard.astro";
import { getHomepageWorkspaceHref } from "../../lib/routes";

interface Props {
  data: HomePageData["credentials"];
  lang: HomePageData["lang"];
  showGalleries?: boolean;
}

type CredentialChapterId =
  "education" | "certifications" | "achievements" | "publications";

const { data, lang, showGalleries = false } = Astro.props;
const headingId = `${data.id}-heading`;
const chapterNavigationLabel =
  lang === "id" ? "Bab kredensial" : "Credential chapters";
const unavailableStatuses = new Set([
  "No public details approved",
  "Belum ada rincian publik yang disetujui",
  "Unavailable",
  "Belum tersedia",
]);
const chapters: readonly {
  id: CredentialChapterId;
  label: string;
  acceptedCategories: readonly string[];
}[] =
  lang === "id"
    ? [
        {
          id: "education",
          label: "Pendidikan",
          acceptedCategories: ["Pendidikan"],
        },
        {
          id: "certifications",
          label: "Lisensi & Sertifikasi",
          acceptedCategories: ["Sertifikasi", "Lisensi & Sertifikasi"],
        },
        {
          id: "achievements",
          label: "Pencapaian",
          acceptedCategories: ["Pencapaian"],
        },
        {
          id: "publications",
          label: "Publikasi",
          acceptedCategories: ["Publikasi"],
        },
      ]
    : [
        {
          id: "education",
          label: "Education",
          acceptedCategories: ["Education"],
        },
        {
          id: "certifications",
          label: "Licenses & Certifications",
          acceptedCategories: ["Certifications", "Licenses & Certifications"],
        },
        {
          id: "achievements",
          label: "Achievements",
          acceptedCategories: ["Achievements"],
        },
        {
          id: "publications",
          label: "Publications",
          acceptedCategories: ["Publications"],
        },
      ];
const populatedChapters = chapters
  .map((chapter) => ({
    ...chapter,
    items: data.items.filter(
      (item) =>
        chapter.acceptedCategories.includes(item.category) &&
        !unavailableStatuses.has(item.statusValue),
    ),
  }))
  .filter((chapter) => chapter.items.length > 0);
const unavailableItems = data.items.filter((item) =>
  unavailableStatuses.has(item.statusValue),
);
const getWorkspaceDestination = (chapterId: CredentialChapterId) =>
  chapterId === "achievements" ? "honors" : chapterId;
---

<section class="credentials-section" id={data.id} aria-labelledby={headingId}>
  <div class="credentials-section__header">
    <h2 class="credentials-section__heading" id={headingId}>{data.heading}</h2>
    <p class="credentials-section__description">{data.description}</p>
  </div>

  {
    populatedChapters.length > 0 && (
      <div class="credentials-section__library">
        <nav
          class="credentials-section__chapters"
          aria-label={chapterNavigationLabel}
        >
          <ul role="list">
            {populatedChapters.map((chapter) => (
              <li>
                <a href={`#credentials-${chapter.id}`}>{chapter.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="credentials-section__ledger">
          {populatedChapters.map((chapter) => (
            <section
              class="credentials-section__chapter"
              id={`credentials-${chapter.id}`}
              aria-labelledby={`credentials-${chapter.id}-heading`}
            >
              <h3
                class="credentials-section__chapter-heading"
                id={`credentials-${chapter.id}-heading`}
              >
                {chapter.label}
              </h3>
              <ul class="credentials-section__list" role="list">
                {chapter.items.map((item) => (
                  <li class="credentials-section__item">
                    {item.credential ? (
                      <div
                        class="credential-record-detail record-detail"
                        id={item.id}
                      >
                        <a
                          class="record-detail__back"
                          href={getHomepageWorkspaceHref(
                            lang,
                            getWorkspaceDestination(chapter.id),
                          )}
                        >
                          <span aria-hidden="true">←</span>
                          {lang === "id" ? "Kembali" : "Back"}
                        </a>
                        <CredentialPreviewCard
                          credential={item.credential}
                          locale={lang}
                          headingLevel={4}
                          showGallery={showGalleries}
                          category={item.category}
                        />
                      </div>
                    ) : (
                      <article class="credential-card">
                        <h4 class="credential-card__heading">
                          {item.category}
                        </h4>
                        <dl class="credential-card__status">
                          <div>
                            <dt>{data.statusLabel}</dt>
                            <dd>{item.statusValue}</dd>
                          </div>
                        </dl>
                      </article>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    )
  }

  {
    unavailableItems.length > 0 && (
      <div class="credentials-section__availability">
        <ul role="list">
          {unavailableItems.map((item) => (
            <li>
              <p class="credentials-section__availability-category">
                {item.category}
              </p>
              <p class="credentials-section__availability-status">
                <span class="visually-hidden">{data.statusLabel}: </span>
                {item.statusValue}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

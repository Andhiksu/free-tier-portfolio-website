---
import type { HomePageData } from "../../types/home";
import { getCredentialsArchivePath } from "../../lib/routes";
import ManagedImage from "../media/ManagedImage.astro";

interface Props {
  data: HomePageData["credentials"];
  locale: HomePageData["lang"];
}

const { data, locale } = Astro.props;
const headingId = "credentials-heading";
---

<section
  class="credential-highlights home-section"
  id="credentials"
  aria-labelledby={headingId}
>
  <div class="home-section__header">
    <div>
      <p class="home-section__eyebrow">
        {locale === "id" ? "Sorotan kredensial" : "Credential highlights"}
      </p>
      <h2 id={headingId}>{data.heading}</h2>
    </div>
    <a class="section-link" href={getCredentialsArchivePath(locale)}>
      {locale === "id" ? "Lihat semua kredensial" : "View all credentials"}
    </a>
  </div>

  <ul class="credential-highlights__list" role="list">
    {
      data.items.slice(0, 3).map((item) => (
        <li>
          <article class="credential-highlight">
            {item.credential?.preview && (
              <ManagedImage
                image={item.credential.preview}
                locale={locale}
                displayMode="thumbnail"
                showCaption={false}
                showCredit={false}
                sizes="6rem"
              />
            )}
            <div>
              <p class="credential-highlight__category">{item.category}</p>
              <h3>{item.credential?.title ?? item.category}</h3>
              {item.credential?.issuer && <p>{item.credential.issuer}</p>}
              {item.credential?.dateLabel && <p>{item.credential.dateLabel}</p>}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>

---
import type { CredentialPresentation } from "../../types/media";
import type { HomeLocale } from "../../types/home";
import { getMediaCopy } from "../../lib/media/copy";
import { isPublicationReady } from "../../lib/media/presentation";
import DocumentActionCard from "./DocumentActionCard.astro";
import EvidenceGallery from "./EvidenceGallery.astro";
import ExternalResourceAction from "./ExternalResourceAction.astro";
import CredentialIssuerMark from "./CredentialIssuerMark.astro";
import MediaState from "./MediaState.astro";
import RelatedContentLink from "./RelatedContentLink.astro";

interface Props {
  credential: CredentialPresentation;
  locale?: HomeLocale;
  headingLevel?: 3 | 4;
  showGallery?: boolean;
  category?: string;
}

const {
  credential,
  locale = "en",
  headingLevel = 3,
  showGallery = false,
  category = "",
} = Astro.props;
const copy = getMediaCopy(locale);
const canPresent = isPublicationReady(credential);
const HeadingTag = headingLevel === 4 ? "h4" : "h3";
const galleryItems = credential.preview
  ? [credential.preview, ...credential.gallery]
  : credential.gallery;
---

{
  canPresent ? (
    <article class="credential-preview">
      <CredentialIssuerMark
        issuer={credential.issuer}
        title={credential.title}
        category={category}
        logo={credential.issuerLogo}
        locale={locale}
      />
      <div class="credential-preview__content">
        <HeadingTag>{credential.title}</HeadingTag>
        <p>{credential.issuer}</p>
        {credential.summary && <p>{credential.summary}</p>}
        {credential.dateLabel && <p>{credential.dateLabel}</p>}
        {credential.credentialId && (
          <p>
            {copy.credentialId}: {credential.credentialId}
          </p>
        )}
        {credential.document && (
          <DocumentActionCard
            document={credential.document}
            locale={locale}
            compact
          />
        )}
        {credential.verification && (
          <ExternalResourceAction
            resource={credential.verification}
            actionLabel={copy.verifyCredential}
            locale={locale}
            headingLevel={4}
          />
        )}
        {credential.related.length > 0 && (
          <nav
            class="credential-preview__related"
            aria-label={copy.relatedCredentialContent}
          >
            {credential.related.map((item) => (
              <RelatedContentLink item={item} locale={locale} />
            ))}
          </nav>
        )}
        {showGallery && galleryItems.length > 0 && (
          <div class="credential-preview__gallery">
            <EvidenceGallery
              id={`${credential.id}-gallery`}
              title={locale === "id" ? "Media kredensial" : "Credential media"}
              items={galleryItems}
              initialCount={4}
              locale={locale}
              headingLevel={4}
              variant="collage"
              showHeading={false}
              showCaption={false}
              showCredit={false}
            />
          </div>
        )}
      </div>
    </article>
  ) : (
    <article class="credential-preview credential-preview--unavailable">
      <div class="credential-preview__content">
        <MediaState
          title={copy.credentialUnavailableTitle}
          message={copy.credentialUnavailableMessage}
          variant={
            credential.availability === "missing" ? "missing" : "unavailable"
          }
        />
      </div>
    </article>
  )
}

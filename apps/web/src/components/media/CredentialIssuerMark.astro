---
import Icon, { type IconName } from "../ui/Icon.astro";
import ManagedImage from "./ManagedImage.astro";
import type { ManagedImagePresentation } from "../../types/media";
import type { HomeLocale } from "../../types/home";

interface Props {
  issuer: string;
  title?: string;
  category?: string;
  compact?: boolean;
  logo?: ManagedImagePresentation;
  locale?: HomeLocale;
}

const {
  issuer,
  category = "",
  compact = false,
  logo,
  locale = "en",
} = Astro.props;
const categoryIdentity = category.toLocaleLowerCase("en");
const icon: IconName =
  categoryIdentity.includes("education") ||
  categoryIdentity.includes("pendidikan")
    ? "education"
    : categoryIdentity.includes("achievement") ||
        categoryIdentity.includes("honor") ||
        categoryIdentity.includes("award") ||
        categoryIdentity.includes("pencapaian") ||
        categoryIdentity.includes("penghargaan")
      ? "honors"
      : "credentials";
const issuerIdentity = (() => {
  const words = issuer
    .replace(/[^\p{L}\p{N}\s]/gu, " ")
    .split(/\s+/)
    .filter(Boolean);
  const mark =
    words.length === 1
      ? words[0]?.slice(0, 4).toLocaleUpperCase("en")
      : words
          .slice(0, 4)
          .map((word) => word[0])
          .join("")
          .toLocaleUpperCase("en");

  return { mark: mark || "ID", key: "generic" };
})();
---

<div
  class:list={[
    "credential-issuer-mark",
    { "credential-issuer-mark--compact": compact },
  ]}
  data-issuer-brand={issuerIdentity.key}
  aria-hidden="true"
>
  {
    logo ? (
      <ManagedImage
        image={logo}
        locale={locale}
        displayMode="thumbnail"
        showCaption={false}
        showCredit={false}
        sizes={compact ? "72px" : "112px"}
      />
    ) : (
      <>
        <span class="credential-issuer-mark__icon" aria-hidden="true">
          <Icon name={icon} />
        </span>
        <strong aria-hidden="true">{issuerIdentity.mark}</strong>
      </>
    )
  }
</div>

---
interface Props {
  title: string;
  message: string;
  variant?: "missing" | "unavailable";
  live?: boolean;
}

const { title, message, variant = "unavailable", live = false } = Astro.props;
---

<div
  class={`media-state media-state--${variant}`}
  role={live ? "status" : undefined}
  aria-live={live ? "polite" : undefined}
>
  <p class="media-state__title">{title}</p>
  <p>{message}</p>
</div>
